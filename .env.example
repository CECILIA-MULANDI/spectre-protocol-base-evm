# ── Foundry deploy script ────────────────────────────────────────────────────
DEPLOYER_PRIVATE_KEY=0x

# World ID Router — Base Sepolia: 0x42FF98C4E85212a5D31358ACbFe76a621b784Fac
# World ID Router — Base Mainnet: 0x57f928158C3EE7CDad1e4D8642503c4D0201f611
WORLD_ID_ROUTER=0x

# 1 = Orb-verified (default for testnet and mainnet)
WORLD_ID_GROUP_ID=1

# World ID external nullifier — derived from app_id + action via the IDKit SDK.
# Generate with: cd world-id-ui && npx tsx src/nullifier.ts
WORLD_ID_EXTERNAL_NULLIFIER=

# Default + minimum recovery cancel window, in blocks. Also the floor any agent
# can pick. e.g. 7200 ≈ 24h on Base. Must be > 0 (constructor reverts otherwise).
DEFAULT_TIMELOCK_BLOCKS=7200

# Address allowed to propose/revoke DKIM keys. Recommend a multisig; an EOA is
# acceptable for v1 if you transferUpdater() to a multisig later (two-step).
DKIM_UPDATER=0x

# Seconds between DKIM propose() and confirm() — the observation window.
# MUST be > 0: a zero value reverts at deploy (DKIMRegistry.InvalidTimelock).
# e.g. 86400 = 24h.
DKIM_PROPOSAL_TIMELOCK=86400

# RPC endpoints (referenced in foundry.toml)
BASE_SEPOLIA_RPC=https://sepolia.base.org
BASE_MAINNET_RPC=https://mainnet.base.org

# Basescan API key for --verify
BASESCAN_API_KEY=

# ── Relayer CLI (relayer/config.json) 
# After deploying, copy these values into relayer/config.json
# REGISTRY_ADDRESS=0x          (SpectreRegistry)
# VERIFIER_ADDRESS=0x          (HonkVerifier)

# ── Relayer signer (owner key) 
# Resolution precedence (most secure first); pick ONE:
#   1. Env-fed key — nothing on disk. Best for CI / secret managers.
SPECTRE_OWNER_KEY=
#   2. Encrypted Web3 v3 keystore + its password (or a file holding it).
SPECTRE_KEYSTORE=
SPECTRE_KEYSTORE_PASSWORD=
# SPECTRE_KEYSTORE_PASSWORD_FILE=/run/secrets/spectre_ks_pw
#   3. DEPRECATED: ownerPrivateKey in relayer/config.json (plaintext, warns).
#      Remove it once 1 or 2 is configured.

# Dev faucet helper (fund-wallet.ts) — a funded Base Sepolia key. NOT the
# previously-hardcoded key in git history; that one is burned, never reuse it.
SPECTRE_FUNDER_KEY=
